{
  "name": "@hemmia/site",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build && vite build --ssr src/render.tsx --outDir dist-ssr && node scripts/prerender.ts && npm run build:demo",
    "build:demo": "HEMMIA_DEMO_OUT=$PWD/dist/demo npm --prefix ../web run build:demo >/dev/null && cp dist/demo/index.html dist/demo/404.html",
    "preview": "vite preview --host 127.0.0.1 --port 4320 --strictPort",
    "check": "npm run build && node scripts/check.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@hemmia/ui": "0.0.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "tailwindcss": "4.3.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "sharp": "0.35.5",
    "vite": "8.3.6"
  }
}
