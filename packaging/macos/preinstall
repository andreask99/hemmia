#!/bin/bash
# Runs as root before the payload is installed: stop a running hub of the console user.
set -u
USER_NAME=$(stat -f %Su /dev/console)
[ "$USER_NAME" = "root" ] || [ -z "$USER_NAME" ] && exit 0
USER_ID=$(id -u "$USER_NAME")
launchctl bootout "gui/$USER_ID/app.hemmia.hub" 2>/dev/null || true
exit 0
